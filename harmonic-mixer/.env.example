# Harmonic Mixer — environment configuration
# Copy this file to .env and fill in your keys.
# Never commit .env to git.

# Anthropic API key — get one at https://console.anthropic.com
HARMONIC_MIXER_ANTHROPIC_API_KEY=

# SoundCloud client ID
# SoundCloud closed new API registrations in 2022.
# To get a client_id: open soundcloud.com, open DevTools → Network tab,
# play any track, and look for requests to api-v2.soundcloud.com —
# the client_id query parameter is in those URLs.
HARMONIC_MIXER_SOUNDCLOUD_CLIENT_ID=
